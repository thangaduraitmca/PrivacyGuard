public with sharing class RandomStringMaskStrategy implements IMaskingStrategy {
    public Object maskValue(Object originalValue, String pattern, String fieldApiName) {
        if (originalValue == null) return null;
        Integer length = 8;
        if (String.isNotBlank(pattern) && pattern.isNumeric()) {
            length = Integer.valueOf(pattern);
        }
        return generateRandomString(length);
    }

    private String generateRandomString(Integer len) {
        String chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        String result = '';
        for (Integer i = 0; i < len; i++) {
            Integer idx = Math.mod(Math.abs(Crypto.getRandomInteger()), chars.length());
            result += chars.substring(idx, idx + 1);
        }
        return result;
    }
}
